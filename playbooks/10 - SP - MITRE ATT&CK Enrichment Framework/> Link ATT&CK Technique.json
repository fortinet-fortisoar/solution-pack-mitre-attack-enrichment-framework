        {
            "@type": "WorkflowStep",
            "name": "Add Comment",
            "description": "Add a comment that the Technique or Sub-Technique record is not available",
            "arguments": {
                "resource": {
                    "type": "\/api\/3\/picklists\/ff599189-3eeb-4c86-acb0-a7915e85ac3b",
                    "__link": {
                        "alerts": "{% if vars.input.records[0]['@type'] == \"Alert\"%}{{vars.input.records[0]['@id']}}{%endif%}",
                        "people": [],
                        "incidents": "{% if vars.input.records[0]['@type'] == \"Incident\"%}{{vars.input.records[0]['@id']}}{%endif%}"
                    },
                    "people": [],
                    "content": "<p>{% if vars. request.method == \"POST\" %}<\/p>\n<p>&nbsp;<\/p>\n<p>The record for MITRE ATT&amp;CK Technique ID&nbsp;<span class=\"badge badge-pill badge-danger\" style=\"background: #ba6204; color: #fff;\">{{vars.input.records[0].mitreattackid}}<\/span> is not available.<\/p>\n<p><em>Recommended action:<\/em><\/p>\n<ul>\n<li><em><em>Ingest MITRE data using playbook <strong>MITRE ATT&amp;CK &gt; Fetch Latest Data<\/strong> or data ingestion<\/em><\/em><\/li>\n<li><em><em>Correlate MITRE ATT&amp;CK data using playbook <strong>Correlate MITRE ATT&amp;CK Data<\/strong><\/em><\/em><\/li>\n<\/ul>\n<p>{% elif vars. request.method == \"PUT\" %}<\/p>\n<p><span class=\"badge badge-pill badge-danger\" style=\"background: #DA393D; color: #fff;\">Error<\/span> Failed to correlate MITRE ATT&amp;CK Technique.<br><em>Reason<\/em>: The MITRE ATT&amp;CK Technique ID <strong><em>{{vars.input.records[0].mitreattackid}}<\/em><\/strong> is either incorrect or not present.<\/p>\n<p>{%endif%}<\/p>",
                    "__replace": "",
                    "isImportant": false,
                    "peopleUpdated": false
                },
                "operation": "Append",
                "collection": "\/api\/3\/comments",
                "__recommend": [],
                "fieldOperation": {
                    "recordTags": "Overwrite"
                },
                "step_variables": []
            },
            "status": null,
            "top": "840",
            "left": "480",
            "stepType": "\/api\/3\/workflow_step_types\/2597053c-e718-44b4-8394-4d40fe26d357",
            "group": null,
            "uuid": "38b05fdb-8cf2-4a2d-bd33-9ef0aefd6a8b"
        },
        {
